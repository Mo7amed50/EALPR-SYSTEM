# EALPR SYSTEM .env template
# Copy to .env and fill values
#
# This file ships with placeholders only. Nothing here is a real credential.

# MongoDB Atlas (REQUIRED)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ealpr_db?retryWrites=true&w=majority
MONGODB_DB_NAME=ealpr_db

# Flask (REQUIRED)
# Development fallback: the placeholder below, or `ealpr-dev-secret`, lets a
# fresh clone boot with no configuration at all. Production refuses both.
# Generate a unique value:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this

# Admin bootstrap (REQUIRED in production)
# Used only when no `admin` account exists yet. The known development default
# `admin123` is refused by production startup (Block C5, S5).
DEFAULT_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Runtime mode (Block C5). These four variables are also described in README.md.
# ---------------------------------------------------------------------------

# development | production | test   (default: development)
#   development - permissive: fallback secrets and the debug flag are allowed.
#   production  - strict: requires a unique SECRET_KEY and a non-default
#                 DEFAULT_ADMIN_PASSWORD, refuses the debug flag, and refuses
#                 a multi-process configuration. Validation happens at startup.
#   test        - deterministic: refuses the debug flag; needs no real secrets.
EALPR_ENV=development

# true|false (default: false). Only honoured when EALPR_ENV=development.
# Any other mode raises RuntimeConfigError at startup.
EALPR_DEBUG=false

# true|false (default: false). Must stay false: the app is single-process and
# the reloader's parent/child pair would run two independent instances.
EALPR_RELOADER=false

# Must be exactly 1 (default: 1). More than one process breaks the inference
# queue's one-consumer guarantee, orphaned-job recovery, and live Socket.IO
# broadcasts. See PHASE2_BLOCK_C5_S1_S3_S4_REPORT.md.
EALPR_WORKERS=1

# Development: python app.py
# Production: waitress-serve --listen=127.0.0.1:5000 --threads=50 app:app
# (loopback bind; use a reverse proxy for external access)

# 21st.dev CLI (optional for local login; required in CI)
# Use `21st login` on a local machine to save a token, or set the API key for non-interactive automation.
# Example local usage:
#   21st login
#   21st whoami
# Example CI usage:
#   21st --api-key "$API_KEY_21ST" search "card design"
API_KEY_21ST=
TWENTYFIRST_TOKEN=

# Models (optional - defaults exist)
MODEL_PATH=working/runs/detect/yolo_car_plate/weights/best.pt
OCR_MODEL_PATH=working/runs/detect/yolo11m_car_plate/weights/best.pt

# Get MONGODB_URI from: https://www.mongodb.com/atlas → Connect → Drivers → Python
